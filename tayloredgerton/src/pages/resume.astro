---
import { education, experience, profile, projects, skillGroups } from '../data/profile';

const resumeProjects = projects
  .filter((project) => project.includeOnResume)
  .sort((a, b) => (a.resumePriority ?? Number.MAX_SAFE_INTEGER) - (b.resumePriority ?? Number.MAX_SAFE_INTEGER));

const usedSkills = new Set([
  ...experience.flatMap((entry) => entry.tags),
  ...education.flatMap((entry) => entry.tags),
  ...projects.flatMap((project) => project.tags),
]);

const resumeSkillGroups = skillGroups
  .map((group) => ({
    label: group.label,
    skills: group.skills.filter((skill) => usedSkills.has(skill)),
  }))
  .filter((group) => group.skills.length > 0);
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content={`${profile.name} — ${profile.focus} resume`}
    />
    <title>{profile.name} — Resume</title>
  </head>
  <body>
    <div class="resume-toolbar" aria-label="Resume actions">
      <a href="/">← Portfolio</a>
      <a href={profile.resume}>Download PDF</a>
      <button type="button" onclick="window.print()">Print</button>
    </div>

    <main class="resume">
      <header class="resume-header">
        <div>
          <h1>{profile.name}</h1>
          <p class="current-role">{profile.currentRole}</p>
          <p class="focus">{profile.focus}</p>
        </div>
        <address>
          <span>{profile.location.replace(' · Open to remote', '')}</span>
          <a href={`mailto:${profile.email}`}>{profile.email}</a>
          <a href={profile.website}>{profile.website.replace('https://', '')}</a>
          <a href={profile.linkedin}>linkedin.com/in/taylor-edgerton</a>
          <a href={profile.github}>github.com/TaylorEdgerton</a>
        </address>
      </header>

      <section aria-labelledby="summary-heading">
        <h2 id="summary-heading">Profile</h2>
        <p>{profile.resumeSummary}</p>
      </section>

      <section aria-labelledby="skills-heading">
        <h2 id="skills-heading">Core Capabilities</h2>
        <dl class="skills">
          {resumeSkillGroups.map((group) => (
            <div>
              <dt>{group.label}</dt>
              <dd>{group.skills.join(' · ')}</dd>
            </div>
          ))}
        </dl>
      </section>

      <section aria-labelledby="experience-heading">
        <h2 id="experience-heading">Experience</h2>
        <div class="entries">
          {experience.map((entry) => (
            <article class="entry">
              <div class="entry-heading">
                <div>
                  <h3>{entry.role}</h3>
                  <p class="organisation">{entry.organisation}</p>
                </div>
                <p class="date">{entry.date}</p>
              </div>
              <ul>
                {entry.resumeBullets.map((bullet) => <li>{bullet}</li>)}
              </ul>
            </article>
          ))}
        </div>
      </section>

      <section aria-labelledby="projects-heading">
        <h2 id="projects-heading">Key Projects</h2>
        <div class="entries compact">
          {resumeProjects.map((project) => (
            <article class="entry">
              <h3>{project.title}</h3>
              <p>{project.resumeDescription}</p>
            </article>
          ))}
        </div>
      </section>

      <section aria-labelledby="education-heading">
        <h2 id="education-heading">Education</h2>
        <div class="entries compact">
          {education.map((entry) => (
            <article class="entry">
              <div class="entry-heading">
                <div>
                  <h3>{entry.qualification}</h3>
                  <p class="organisation">{entry.institution}</p>
                </div>
                <p class="date">{entry.date}</p>
              </div>
              <p>{entry.resumeDescription}</p>
            </article>
          ))}
        </div>
      </section>
    </main>
  </body>
</html>

<style>
  :root {
    color: #252525;
    background: #ecebe8;
    font-family: Arial, Helvetica, sans-serif;
    font-size: 15px;
    line-height: 1.45;
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  .resume-toolbar {
    display: flex;
    justify-content: flex-end;
    gap: 0.75rem;
    width: min(210mm, calc(100% - 2rem));
    margin: 1rem auto;
  }

  .resume-toolbar a,
  .resume-toolbar button {
    border: 1px solid #b9b5ad;
    border-radius: 4px;
    background: #fff;
    color: #3f3d38;
    padding: 0.45rem 0.75rem;
    font: inherit;
    font-size: 0.8rem;
    cursor: pointer;
  }

  .resume {
    width: min(210mm, 100%);
    min-height: 297mm;
    margin: 0 auto 2rem;
    padding: 13mm 15mm;
    background: #fff;
    box-shadow: 0 8px 30px rgb(0 0 0 / 12%);
  }

  .resume-header {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 2rem;
    align-items: start;
    padding-bottom: 0.9rem;
    border-bottom: 2px solid #272727;
  }

  h1,
  h2,
  h3,
  p {
    margin-top: 0;
  }

  h1 {
    margin-bottom: 0.1rem;
    font-size: 2rem;
    line-height: 1.1;
    letter-spacing: -0.035em;
  }

  .current-role {
    margin: 0.18rem 0 0;
    color: #34322f;
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.3;
  }

  .focus {
    margin: 0.08rem 0 0;
    color: #625d55;
    font-size: 0.86rem;
    font-weight: 500;
    line-height: 1.3;
  }

  address {
    display: grid;
    justify-items: end;
    color: #4e4b46;
    font-size: 0.72rem;
    font-style: normal;
    line-height: 1.45;
  }

  address a {
    border-bottom: 1px solid #d8d5cf;
  }

  section {
    margin-top: 1rem;
  }

  h2 {
    margin-bottom: 0.55rem;
    color: #756247;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h3 {
    margin-bottom: 0.05rem;
    font-size: 0.9rem;
    line-height: 1.3;
  }

  p,
  li,
  dd,
  dt {
    font-size: 0.76rem;
  }

  section > p,
  .entry > p {
    margin-bottom: 0;
  }

  .skills {
    display: grid;
    gap: 0.2rem;
    margin: 0;
  }

  .skills > div {
    display: grid;
    grid-template-columns: 34mm minmax(0, 1fr);
    gap: 0.5rem;
  }

  .skills dt {
    font-weight: 700;
  }

  .skills dd {
    margin: 0;
  }

  .entries {
    display: grid;
    gap: 0.8rem;
  }

  .entries.compact {
    gap: 0.55rem;
  }

  .entry {
    break-inside: avoid;
  }

  .entry-heading {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: baseline;
  }

  .organisation {
    margin-bottom: 0.2rem;
    color: #625d55;
    font-size: 0.72rem;
    font-weight: 600;
  }

  .date {
    flex: none;
    margin-bottom: 0;
    color: #625d55;
    font-size: 0.7rem;
    font-weight: 600;
    white-space: nowrap;
  }

  ul {
    margin: 0.2rem 0 0;
    padding-left: 1.05rem;
  }

  li {
    margin-bottom: 0.14rem;
    padding-left: 0.1rem;
  }

  @media (max-width: 650px) {
    .resume {
      min-height: 0;
      padding: 1.4rem;
    }

    .resume-header {
      grid-template-columns: 1fr;
      gap: 0.7rem;
    }

    address {
      justify-items: start;
    }

    .skills > div {
      grid-template-columns: 1fr;
      gap: 0;
    }
  }

  @page {
    size: A4;
    margin: 0;
  }

  @media print {
    :root {
      background: #fff;
      print-color-adjust: exact;
      -webkit-print-color-adjust: exact;
    }

    .resume-toolbar {
      display: none;
    }

    .resume {
      width: 210mm;
      min-height: auto;
      margin: 0;
      padding: 10mm 14mm;
      box-shadow: none;
    }

    section {
      margin-top: 0.65rem;
    }

    .entries {
      gap: 0.5rem;
    }

    .entries.compact {
      gap: 0.35rem;
    }

    p,
    li,
    dd,
    dt {
      font-size: 0.72rem;
    }

    a {
      text-decoration: none;
    }
  }
</style>
